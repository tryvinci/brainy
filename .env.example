# Brainy Go rebuild
BRAINY_ENV=local
BRAINY_HTTP_ADDR=:8080
BRAINY_DATABASE_URL=postgres://brainy:brainy@localhost:5432/brainy?sslmode=disable
BRAINY_WORKER_MODE=once
BRAINY_WORKER_POLL_INTERVAL=2s

# Hosted / staging (Track C): comma-separated tenant_id:api_key pairs
# Wildcard "*" skips tenant_id binding (needed for OpMem benchmarks).
# BRAINY_API_KEYS=*:sk_staging_bench,demo:sk_demo
# BRAINY_REQUIRE_API_KEY=false
#
# Eval clients against a keyed staging host:
# BRAINY_API_KEY=sk_staging_bench

# Async worker provider extract (OpenAI-compatible). Empty => deterministic only.
# BRAINY_PROVIDER_BASE_URL=https://api.openai.com/v1
# BRAINY_PROVIDER_API_KEY=
# BRAINY_PROVIDER_MODEL=gpt-4o-mini
# BRAINY_PROVIDER_TIMEOUT=45s
# Aliases also accepted: LLM_BASE_URL, LLM_API_KEY, LLM_MODEL
