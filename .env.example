# Brainy Go rebuild
BRAINY_ENV=local
BRAINY_HTTP_ADDR=:8080
BRAINY_DATABASE_URL=postgres://brainy:brainy@localhost:5432/brainy?sslmode=disable
BRAINY_WORKER_MODE=once
BRAINY_WORKER_POLL_INTERVAL=2s

# Hosted / staging (Track C): comma-separated tenant_id:api_key pairs
# Wildcard "*" skips tenant_id binding (needed for OpMem benchmarks).
# BRAINY_API_KEYS=*:sk_staging_bench,demo:sk_demo
# BRAINY_REQUIRE_API_KEY=false
#
# Eval clients against a keyed staging host:
# BRAINY_API_KEY=sk_staging_bench

# Async worker provider extract (OpenAI-compatible). Empty => deterministic only.
# BRAINY_PROVIDER_BASE_URL=https://api.openai.com/v1
# BRAINY_PROVIDER_API_KEY=
# BRAINY_PROVIDER_MODEL=gpt-4o-mini
# BRAINY_PROVIDER_TIMEOUT=45s
# Aliases also accepted: LLM_BASE_URL, LLM_API_KEY, LLM_MODEL

# Provider embeddings (OpenAI-compatible). Empty model => local hash embedder.
# BRAINY_EMBEDDING_BASE_URL=   # defaults to BRAINY_PROVIDER_BASE_URL / LLM_BASE_URL
# BRAINY_EMBEDDING_API_KEY=
# BRAINY_EMBEDDING_MODEL=
# BRAINY_EMBEDDING_TIMEOUT=30s
# Alias: EMBEDDING_MODEL
# Local eval embeddings server: python evals/tools/local_embeddings_server.py

# Experimental retrieval reranking (see docs/benchmarks/entity-linking-ab.md).
# Both regressed the local same-pin smoke without re-tuning the boost stack and
# are OFF by default; enable on staging (with a strong hosted embedder) to
# re-tune and re-measure. Do not tune these to a benchmark.
# BRAINY_ENTITY_RANKING=   # true|false; default: auto-on when EMBEDDING_MODEL set
# BRAINY_IDF_RANKING=false # BM25-style IDF-weighted lexical coverage
