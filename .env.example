# Brainy Go rebuild
BRAINY_ENV=development
BRAINY_HTTP_ADDR=:8080
BRAINY_DATABASE_URL=postgres://brainy:brainy@localhost:5432/brainy?sslmode=disable
BRAINY_WORKER_MODE=once
BRAINY_WORKER_POLL_INTERVAL=2s

# Hosted beta (Track C): comma-separated tenant_id:api_key pairs
# BRAINY_API_KEYS=demo:sk_demo_local,acme:sk_acme_local
# BRAINY_REQUIRE_API_KEY=false
