{
  "name": "cor01_basic_revision",
  "category": "correction",
  "description": "After a revision, recall must return the revised content, not the original.",
  "steps": [
    { "op": "remember", "id": "m1", "actor": "a1", "content": "I prefer Python for scripting." },
    { "op": "recall", "actor": "a1", "query": "scripting", "expect": { "min_results": 1, "top_contains": "python" } },
    { "op": "revise", "actor": "a1", "target": "m1", "content": "Prefers Ruby for scripting" },
    { "op": "recall", "actor": "a1", "query": "scripting", "expect": { "min_results": 1, "top_contains": "ruby", "must_exclude": ["python"] } }
  ]
}
