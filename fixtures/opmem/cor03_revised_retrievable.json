{
  "name": "cor03_revised_retrievable",
  "category": "correction",
  "description": "A revised memory must be retrievable by its new terms.",
  "steps": [
    { "op": "remember", "id": "m1", "actor": "a1", "content": "I prefer Python for scripting." },
    { "op": "revise", "actor": "a1", "target": "m1", "content": "Prefers Ruby for scripting" },
    { "op": "recall", "actor": "a1", "query": "ruby", "expect": { "min_results": 1, "top_contains": "ruby" } }
  ]
}
